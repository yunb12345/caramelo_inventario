# URL base de la API, SIN el sufijo /api.
#
# Vacio (o ausente) => el frontend llama a /api en el mismo origen:
#   - en desarrollo lo resuelve el proxy de Vite (127.0.0.1:3001)
#   - en Docker lo resuelve nginx
#
# En Render (static site separado de la API) hay que apuntarla al dominio de la API:
# VITE_API_BASE_URL="https://caramelo-api.onrender.com"
#
# Ojo: Vite la congela en el build. Cambiarla requiere rebuild del frontend.
VITE_API_BASE_URL=""
