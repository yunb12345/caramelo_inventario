# Conexion a PostgreSQL
#
# Local (PostgreSQL instalado en la maquina):
DATABASE_URL="postgresql://caramelo:caramelo@127.0.0.1:5432/caramelo"
#
# Supabase: usar la cadena "Session pooler" (puerto 5432), NO la de 6543
# (transaction pooler), porque las ventas usan transacciones SQL.
#
# DATABASE_URL="postgresql://postgres.<project-ref>:TU_PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify"
#
# Por que:
# - La "Direct connection" (db.<project-ref>.supabase.co) es IPv6-only. Desde
#   GitHub Actions o Render (sin IPv6 saliente) no conecta nunca.
# - sslmode=no-verify: con pg 8.x, require/prefer equivalen a verify-full y el
#   certificado del pooler no valida (SELF_SIGNED_CERT_IN_CHAIN). Sin sslmode,
#   pg conecta en texto plano. no-verify cifra sin verificar el certificado.
#
# Verificar antes de migrar: pnpm db:check

# Servidor
# En Render NO definas PORT: la plataforma lo inyecta (por defecto 10000).
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Seguridad
# Generar uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="12h"
# Dominios permitidos, separados por coma. Solo importa si el frontend esta en otro origen.
CORS_ORIGIN="http://localhost:5173"

# Usuario administrador inicial (lo usa el seed)
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@caramelo.local"
ADMIN_PASSWORD="caramelo123"

# Seed de datos demo (catalogo + ventas de ejemplo).
# Si no se define: se cargan fuera de produccion y se omiten con NODE_ENV=production.
# En produccion dejar "false" para crear solo el usuario administrador.
# SEED_DEMO="false"

# --- Produccion (Render + Supabase) -------------------------------------
# NODE_ENV="production"
# DATABASE_URL="postgresql://postgres.<project-ref>:TU_PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify"
# CORS_ORIGIN="https://caramelo-web.onrender.com"
# SEED_DEMO="false"
