# Variables para docker-compose.prod.yml
# Copiar a .env (raiz del repo, esta en .gitignore) y completar.

POSTGRES_USER=caramelo
# Evita caracteres especiales (@ : / # ?) o codificalos en URL.
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=caramelo

# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=12h

# Origen del frontend (con el proxy de nginx todo es mismo origen).
CORS_ORIGIN=http://localhost:8080

ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@caramelo.local
ADMIN_PASSWORD=cambia-esta-clave

# false = solo crea el usuario admin, sin catalogo/ventas demo.
SEED_DEMO=false

# Puerto publicado por nginx en el host.
WEB_PORT=8080
